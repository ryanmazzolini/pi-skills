{
  "name": "@ryanmazzolini/pi-skills",
  "version": "1.0.0",
  "type": "module",
  "description": "Opinionated pi skills — planning, git workflows, code review, and dev conventions",
  "keywords": ["pi-package"],
  "bin": {
    "daily-report": "skills/notes/daily-report/scripts/daily-report.mjs",
    "scheduled-jobs": "bin/scheduled-jobs.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run validate:skills && npm run typecheck:extensions && node --test",
    "typecheck:extensions": "tsc --noEmit -p tsconfig.extensions.json",
    "validate:skills": "node scripts/validate-skills.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanmazzolini/pi-skills.git"
  },
  "homepage": "https://github.com/ryanmazzolini/pi-skills#readme",
  "bugs": {
    "url": "https://github.com/ryanmazzolini/pi-skills/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10 <2",
    "@earendil-works/pi-tui": ">=0.80.10 <2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.8",
    "typescript": "^5.9.3"
  },
  "pi": {
    "skills": ["./skills"],
    "extensions": ["./extensions"]
  }
}
