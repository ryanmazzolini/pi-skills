{
  "mcpServers": {
    "browser-control-personal": {
      "command": "node",
      "args": ["dist/server.js"],
      "cwd": "./browser-control-mcp/mcp-server",
      "env": {
        "EXTENSION_SECRET": "!cat ../../.secrets/browser-control-personal",
        "EXTENSION_PORT": "8089"
      }
    },
    "browser-control-secondary": {
      "command": "node",
      "args": ["dist/server.js"],
      "cwd": "./browser-control-mcp/mcp-server",
      "env": {
        "EXTENSION_SECRET": "!cat ../../.secrets/browser-control-secondary",
        "EXTENSION_PORT": "8090"
      }
    }
  }
}
